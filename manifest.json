{
  "manifest_version": 3,
  "name": "ListFill for Meesho",
  "version": "1.1.2",
  "description": "Save reusable product variants and autofill the Meesho supplier Add Product form in one click. Independent unofficial tool.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ListFill for Meesho",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://supplier.meesho.com/*",
    "https://*.meesho.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://supplier.meesho.com/*",
        "https://*.meesho.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "shared.js",
        "src/locator.js",
        "src/fill.js",
        "src/capture.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
